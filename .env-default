APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tbl
DB_USER=root
DB_PASS=root1234
REDIS_URL=redis://127.0.0.1:6379/0
# Заменить ключ перед деплоем в production.
AUTH_SECRET_KEY=change_before_use
AUTH_COOKIE_NAME=practise_auth
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=practise_csrf
LOGO_CACHE_TTL_SECONDS=86400
LOGO_BATCH_MAX_IDS=80
DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs
DADATA_QUERY_MAX_LENGTH=300
DADATA_LOOKUP_TIMEOUT_SECONDS=10
DADATA_REFRESH_INTERVAL_DAYS=30
DADATA_MAX_REQUESTS_PER_SECOND=25
DADATA_FULL_REFRESH_REQUESTS_PER_SECOND=20
DADATA_DAILY_REQUEST_LIMIT=10000
DADATA_MAX_CONCURRENT_REQUESTS=10
DADATA_MAX_NEW_CONNECTIONS_PER_MINUTE=50
DADATA_REFRESH_BATCH_SIZE=50
DADATA_FULL_REFRESH_CONCURRENCY=10
DADATA_JOB_STATUS_TTL_SECONDS=86400
DADATA_FULL_REFRESH_DAILY_LIMIT=1
DADATA_FULL_REFRESH_LOCK_TTL_SECONDS=900
DADATA_ALLOW_MANUAL_FULL_REFRESH_AFTER_SCHEDULED=false
DADATA_DAILY_REQUEST_RESERVE=200
DADATA_MAX_RETRIES=3
DADATA_RETRY_BASE_DELAY_SECONDS=0.5
DADATA_SCHEDULE_INITIAL_REFRESH=false
DADATA_FALLBACK_REQUESTS_PER_SECOND=3
DADATA_MAX_ACTIVE_MANUAL_JOBS_PER_USER=3
DADATA_WORKER_REPLICAS=2
DOCKER_DB_NAME=tbl
DOCKER_DB_PASS=root
